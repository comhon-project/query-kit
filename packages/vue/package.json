{
  "name": "@query-kit/vue",
  "version": "1.0.1",
  "description": "Vue 3 query builder and filter UI components, plus a schema-driven, sortable and paginated data table for displaying results. Server-side querying, written in TypeScript.",
  "author": "Jean-Philippe Perrotton <jeanphilippe.perrotton@gmail.com>",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "index.ts",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "vue",
    "vue3",
    "query-builder",
    "filter-builder",
    "query",
    "filter",
    "filtering",
    "search",
    "advanced-search",
    "condition",
    "operators",
    "data-table",
    "datatable",
    "pagination",
    "schema-driven",
    "typescript",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comhon-project/query-kit.git",
    "directory": "packages/vue"
  },
  "homepage": "https://comhon-project.github.io/query-kit/",
  "bugs": {
    "url": "https://github.com/comhon-project/query-kit/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest --config vitest.config.ts",
    "test:coverage": "vitest --config vitest.config.ts --coverage",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type-check": "vue-tsc --noEmit",
    "check": "npm run lint:check && npm run type-check && vitest run --config vitest.config.ts && npm run build && publint && attw --pack .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "luxon": "^3.7.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.0.3",
    "@microsoft/api-extractor": "^7.58.12",
    "@query-kit/themes": "*",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.2.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.0.16",
    "vue": "^3.5.40",
    "vue-tsc": "^3.2.1"
  }
}
